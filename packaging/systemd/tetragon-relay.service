# /usr/lib/systemd/system/tetragon-relay.service
#
# Step 3 prompt Part C: adds ExecStartPre=+/usr/libexec/tetragon-relay/
# relay-probe ahead of the architecture doc section 8.7 unit. The leading
# "+" runs that one line as root (systemd.service(5)) even though the unit
# itself runs as the unprivileged tetragon-relay user; relay-probe gathers
# host facts (kernel config, SELinux, usrmerge, Secure Boot/lockdown state,
# the Tetragon binary's hash) that require root to read, and writes them
# atomically to /run/tetragon-relay/host-facts.json (root:tetragon-relay,
# 0640) for the agent to read at startup via internal/hostprobe. If
# relay-probe fails, systemd aborts the start (ExecStartPre failures are
# fatal by default): the agent never starts in a state where it cannot
# establish host capabilities, and (per internal/hostprobe.Load's
# fail-closed behavior) would otherwise have silently refused every
# enforcement bundle without explanation.
[Unit]
Description=Tetragon relay agent
After=network-online.target tetragon.service
Wants=network-online.target
BindsTo=tetragon.service

[Service]
Type=notify
User=tetragon-relay
Group=tetragon-relay
SupplementaryGroups=tss
RuntimeDirectory=tetragon-relay
RuntimeDirectoryMode=0750
# step-05a prompt Part C3 / ADR 0029: provisions (or validates) the
# persistent SRK and the TPM NV counter index used for store rollback
# protection. Provisioning (only) requires TPM owner-hierarchy
# authorization, hence root (the same ExecStartPre=+ as the host-facts
# probe below); relayd itself (unprivileged) never uses owner-hierarchy
# authorization at all -- it only loads the already-persistent SRK and
# reads/increments the already-defined counter index, each under its own
# authorization. Idempotent, so safe to run on every unit start, not just
# the first time these objects are absent.
#
# If this host's TPM owner hierarchy already has a password set (common
# under some enterprise TPM provisioning standards), write it to a
# root-only file and add --tpm-owner-auth-file <path> to the line below;
# the common case (no TPM owner password) omits the flag entirely, as
# here. This file is read once, by this root-run command, and never by
# relayd (docs/decisions/0029-no-tpm-owner-authorization-at-runtime.md).
ExecStartPre=+/usr/libexec/tetragon-relay/relay-probe --provision-tpm --tpm-device /dev/tpmrm0
ExecStartPre=+/usr/libexec/tetragon-relay/relay-probe --tetragon-binary /usr/local/bin/tetragon --relay-group tetragon-relay --facts-path /run/tetragon-relay/host-facts.json
ExecStart=/usr/libexec/tetragon-relay/relayd --config /etc/tetragon-relay/relay.yaml
WatchdogSec=30s
Restart=always
RestartSec=2s

# Privilege
NoNewPrivileges=yes
# No capabilities. step-03a-review.md R3-1: commit 6be5137 granted
# CAP_SYS_PTRACE here to let internal/tetra read the Tetragon socket
# peer's /proc/<pid>/exe, but that capability lets relayd inspect and
# read the memory of any process on the host (sshd, systemd, Tetragon
# itself) — a compromised agent would be root-equivalent, violating
# architecture doc P9 and section 8.7 (no capabilities). The exe check
# was replaced by internal/tetra's SO_PEERSEC (peer SELinux domain) and
# cgroup v2 membership checks (dial_linux.go, peercgroup_linux.go), which
# need no capability at all. CAP_SYS_PTRACE also would have defeated
# ProtectProc=invisible below outright (systemd.exec(5): "the root user
# is unaffected by this option... and also without the CAP_SYS_PTRACE
# capability, which also allows a process to bypass this feature").
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot-locked

# Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no            # needs /dev/tpmrm0
DeviceAllow=/dev/tpmrm0 rw
DevicePolicy=closed
ReadWritePaths=/var/lib/tetragon-relay /var/spool/tetragon-relay /etc/tetragon/tetragon.tp.d/relay
ReadOnlyPaths=/etc/tetragon-relay
# /run/tetragon-relay is NOT listed in ReadOnlyPaths: RuntimeDirectory=
# above already makes it writable for the unit's whole process tree
# (including the root ExecStartPre), which relay-probe needs in order to
# write host-facts.json; ReadOnlyPaths would block that write (namespacing
# directives apply to every Exec* of the unit, not just ExecStart).
InaccessiblePaths=/root /home
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel surface
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
IPAddressDeny=any
IPAddressAllow=10.20.0.0/24  # management core only; mirrors switch policy
UMask=0077

# Resource bounds
MemoryMax=256M
CPUQuota=25%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
